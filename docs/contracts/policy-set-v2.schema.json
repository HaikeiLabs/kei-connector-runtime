{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.haikeilabs.com/kei/policy-set-v2.schema.json",
  "title": "kei.policy-set/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "org_id", "workspace_id", "match_semantics", "evaluation", "tools", "checks", "tool_policies", "harness_match_semantics", "harness_policies"],
  "properties": {
    "schema": {"const": "kei.policy-set/v2"},
    "org_id": {"$ref": "#/$defs/id"},
    "workspace_id": {"$ref": "#/$defs/id"},
    "match_semantics": {"const": "kei.match/v2"},
    "evaluation": {"type": "object", "additionalProperties": false, "required": ["precedence", "checks", "default"], "properties": {"precedence": {"const": ["priority_desc", "deny_before_permit", "policy_id_asc"]}, "checks": {"const": "per_capability_first_match_and"}, "default": {"const": "deny"}}},
    "tools": {"type": "array", "items": {"$ref": "#/$defs/tool"}},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "tool_policies": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "harness_match_semantics": {"const": "kei.harness-match/v1"},
    "harness_policies": {"type": "array", "items": {"$ref": "#/$defs/harnessPolicy"}},
    "connectors": {"description": "Optional (HAI-378, ADR-034 amendment 2026-10-11). The non-secret descriptor of every active workspace connector the bundle routes to, sorted by id. Every route.connector_binding.connector_id and agent_connector_bindings[].connector_id names an entry here once the catalog emits this field. A descriptor carries where the credential lives (a kei://connectors reference and the backend kind), never the credential. Older runtimes reject this field (closed schema), so the catalog emits it only once runtimes that accept it are the minimum supported.", "type": "array", "items": {"$ref": "#/$defs/connectorDescriptor"}}
  },
  "$defs": {
    "harnessPolicy": {"type": "object", "additionalProperties": false, "required": ["policy_id", "name", "src_pattern", "dst_pattern", "action", "priority", "scope"], "properties": {"policy_id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}, "src_pattern": {"type": "string", "minLength": 1}, "dst_pattern": {"type": "string", "minLength": 1}, "action": {"enum": ["permit", "deny"]}, "priority": {"type": "integer"}, "scope": {"$ref": "#/$defs/scope"}}},
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "capability": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"},
    "resourceType": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "parent_type": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}}},
    "connectorRoute": {"type": "object", "additionalProperties": false, "required": ["connector_binding"], "properties": {"connector_binding": {"type": "object", "additionalProperties": false, "required": ["connector_id"], "properties": {"connector_id": {"$ref": "#/$defs/id"}}}}, "minProperties": 1, "maxProperties": 1},
    "harnessRoute": {"type": "object", "additionalProperties": false, "required": ["harness_executor"], "properties": {"harness_executor": {"type": "object", "additionalProperties": false, "required": ["executor", "registration"], "properties": {"executor": {"type": "string", "minLength": 1, "maxLength": 128}, "registration": {"type": "string", "minLength": 1, "maxLength": 128}}}}, "minProperties": 1, "maxProperties": 1},
    "reference": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["from", "pointer", "type"], "properties": {"from": {"const": "args"}, "pointer": {"type": "string", "minLength": 2, "maxLength": 129, "pattern": "^/[^/]+$"}, "type": {"enum": ["string", "integer", "number", "boolean", "object", "array"]}}},
      {"type": "object", "additionalProperties": false, "required": ["from", "field", "type"], "properties": {"from": {"const": "context"}, "field": {"type": "string", "minLength": 1, "maxLength": 128}, "type": {"enum": ["string", "integer", "number", "boolean", "object", "array"]}}}
    ]},
    "resource": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "id": {"$ref": "#/$defs/reference"}, "parent": {"type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": {"type": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "id": {"$ref": "#/$defs/reference"}}}}},
    "operation": {"type": "object", "additionalProperties": false, "required": ["id", "capability", "provider_resource_template", "provider_input"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "capability": {"$ref": "#/$defs/capability"}, "resource": {"$ref": "#/$defs/resource"}, "provider_resource_template": {"type": "string", "minLength": 1, "maxLength": 4096}, "provider_input": {}}},
    "plan": {"type": "object", "additionalProperties": false, "required": ["args_schema", "context_schema", "operations"], "properties": {"args_schema": {"type": "object"}, "context_schema": {"type": "object"}, "operations": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/operation"}}}},
    "connectorTool": {"type": "object", "additionalProperties": false, "required": ["name", "source", "operation_class", "route", "required_capabilities", "plan"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"}, "source": {"type": "string", "minLength": 1}, "operation_class": {"type": "string", "enum": ["read", "write"]}, "route": {"$ref": "#/$defs/connectorRoute"}, "required_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}}, "resource_types": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/resourceType"}}, "plan": {"$ref": "#/$defs/plan"}}},
    "harnessTool": {"type": "object", "additionalProperties": false, "required": ["name", "source", "operation_class", "route"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"}, "source": {"type": "string", "minLength": 1}, "operation_class": {"type": "string", "enum": ["read", "write"]}, "route": {"$ref": "#/$defs/harnessRoute"}}},
    "tool": {"oneOf": [{"$ref": "#/$defs/connectorTool"}, {"$ref": "#/$defs/harnessTool"}]},
    "scope": {"type": "object", "additionalProperties": false, "required": ["org_id", "workspace_id", "agent_id"], "properties": {"org_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "workspace_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "agent_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}}},
    "selector": {"type": "object", "additionalProperties": false, "required": ["source_principal"], "properties": {"source_principal": {"type": "string", "minLength": 1}, "source": {"type": "string"}, "connector_id": {"$ref": "#/$defs/id"}, "tool": {"type": "string"}, "capability": {"$ref": "#/$defs/capability"}, "resource_type": {"type": "string"}, "resource_id": {"type": "string"}, "resource_parent": {"type": "string"}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["policy_id", "name", "effect", "priority", "scope", "selector"], "properties": {"policy_id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}, "effect": {"enum": ["permit", "deny"]}, "priority": {"type": "integer"}, "scope": {"$ref": "#/$defs/scope"}, "selector": {"$ref": "#/$defs/selector"}}},
    "connectorDescriptor": {"type": "object", "additionalProperties": false, "required": ["id", "provider", "credential_source", "capabilities"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"description": "The connector's display name (for example crm). Informational; decisions key on id.", "type": "string", "minLength": 1, "maxLength": 128}, "provider": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "capabilities": {"description": "The connector's declared capabilities, intersected with the kei-connector-contracts capability catalog for the provider. The runtime still refuses a capability its contracts version does not define.", "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/connectorCapability"}}, "credential_source": {"description": "Where the connector's credential comes from. Always explicit in the bundle; the empty-means-opaque_ref default of contract.Metadata does not apply here.", "enum": ["oauth", "opaque_ref"]}, "account_model": {"description": "Whose account the connector acts as. Required for oauth. In identity mode the runtime executes per_user oauth with the session's own released token, and opaque_ref with the tenant secret store; domain_delegation denies with account_model_not_supported.", "enum": ["per_user", "shared", "domain_delegation"]}, "credential_ref": {"description": "opaque_ref only. The runtime-local reference kei://connectors/<connector id>/<secret field>, where the field is the provider's setup field with location credential (kei-connector-contracts setup). kei-proxy resolves it inside the daemon through its connector reference index (written by kei-proxy credential sync) and the tenant secret store. It is not the catalog's stored secret name and never a secret value.", "type": "string", "maxLength": 512, "pattern": "^kei://connectors/[A-Za-z0-9][A-Za-z0-9._-]*/[a-z][a-z0-9_]*$"}, "credential_backend": {"description": "opaque_ref only. The kind of the organization's active credential store. The runtime denies with credential_backend_mismatch when its local reference index names a different backend for credential_ref.", "enum": ["aws-secrets-manager", "azure-key-vault", "gcp-secret-manager", "vault", "custom"]}, "config": {"description": "The provider's non-secret setup fields (setup location config), for example gmail include_body or google drive_id. Secret fields (location credential) never appear; a secret-shaped key is a schema violation.", "type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$", "not": {"pattern": "(secret|token|passw|api_?key|private_?key|credential|bearer|authorization|cookie|signature)"}}, "additionalProperties": {"oneOf": [{"type": "string", "maxLength": 2048}, {"type": "number"}, {"type": "boolean"}, {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 2048}}]}}, "http_api": {"$ref": "#/$defs/httpAPIDescriptor"}, "grafana": {"type": "object", "additionalProperties": false, "required": ["base_url"], "properties": {"base_url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048}}}, "kind": {"description": "Optional until runtimes that accept it are the minimum supported (ADR-036 §4.3, HAI-570); required once emitted. The connector's kind, from its template. The catalog describes native, http_api and mcp connectors.", "enum": ["mcp", "http_api", "cli", "database", "native"]}, "slug": {"description": "Optional until runtimes that accept it are the minimum supported (ADR-036 §4.3, HAI-570); required once emitted, and always for mcp. The connector's immutable slug (ADR-036 §3.4): it names the connector in policy (mcp:<slug>.<tool>) and in the /mcp/{slug} route.", "type": "string", "pattern": "^[a-z][a-z0-9_]{1,47}$"}, "mcp": {"$ref": "#/$defs/mcpDescriptor"}}, "allOf": [{"if": {"properties": {"credential_source": {"const": "opaque_ref"}}}, "then": {"required": ["credential_ref", "credential_backend"]}}, {"if": {"properties": {"credential_source": {"const": "oauth"}}}, "then": {"required": ["account_model"], "not": {"anyOf": [{"required": ["credential_ref"]}, {"required": ["credential_backend"]}]}}}, {"if": {"properties": {"provider": {"const": "http_api"}}}, "then": {"required": ["http_api"], "properties": {"credential_source": {"const": "opaque_ref"}}}, "else": {"not": {"required": ["http_api"]}}}, {"if": {"properties": {"provider": {"const": "grafana"}}}, "then": {"required": ["grafana"]}, "else": {"not": {"required": ["grafana"]}}}, {"if": {"required": ["kind"], "properties": {"kind": {"const": "mcp"}}}, "then": {"required": ["slug", "mcp"]}, "else": {"not": {"required": ["mcp"]}}}]},
    "mcpDescriptor": {"description": "mcp kind only (ADR-036 §4.3, HAI-570). Where the /mcp/{slug} route reaches the server, and the approved tool manifest it verifies upstream listings against (§5.3). Tool definitions are never carried: only each approved tool's name and tool_hash (§5.2). approved_manifest_hash is null while no manifest is approved, and approved_tools is then empty; the route denies with mcp_manifest_unapproved.", "type": "object", "additionalProperties": false, "required": ["url", "transport", "auth_method", "approved_manifest_hash", "approved_tools"], "properties": {"url": {"description": "The canonical MCP server URL (the connector's mcp_url).", "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048}, "transport": {"description": "The upstream transport (§4.2). The harness side is always Streamable HTTP.", "enum": ["streamable_http", "sse"]}, "auth_method": {"description": "The template's auth method (§3.3).", "enum": ["sso_reuse", "oauth", "secret_ref", "none"]}, "approved_manifest_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256Hash"}]}, "approved_tools": {"description": "Sorted by name.", "type": "array", "maxItems": 512, "items": {"type": "object", "additionalProperties": false, "required": ["name", "tool_hash"], "properties": {"name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"}, "tool_hash": {"$ref": "#/$defs/sha256Hash"}}}}}, "if": {"properties": {"approved_manifest_hash": {"type": "null"}}}, "then": {"properties": {"approved_tools": {"maxItems": 0}}}},
    "sha256Hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "connectorCapability": {"type": "object", "additionalProperties": false, "required": ["name", "mutating"], "properties": {"name": {"$ref": "#/$defs/capability"}, "mutating": {"type": "boolean"}}},
    "httpAPIDescriptor": {"description": "The http_api registration (kei-connector-contracts contract.HTTPAPI). POST and PATCH are valid only with a contracts version that defines http.post and http.patch (kei-connector-contracts#21); a request body is per call and never part of the descriptor.", "type": "object", "additionalProperties": false, "required": ["registered_base_url", "registered_hostname", "allowed_methods", "allowed_path_patterns", "query_allowlist", "request_max_bytes", "response_max_bytes", "timeout_ms", "allow_redirects", "max_redirects", "allow_cross_host_redirects", "credential_injection", "redaction"], "properties": {"registered_base_url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048}, "registered_hostname": {"type": "string", "minLength": 1, "maxLength": 253}, "allowed_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["GET", "HEAD", "POST", "PATCH"]}}, "allowed_path_patterns": {"type": "array", "items": {"type": "string", "minLength": 1}}, "query_allowlist": {"type": "array", "items": {"type": "string", "minLength": 1}}, "request_max_bytes": {"type": "integer", "minimum": 0}, "response_max_bytes": {"type": "integer", "minimum": 1}, "timeout_ms": {"type": "integer", "minimum": 1}, "allow_redirects": {"type": "boolean"}, "max_redirects": {"type": "integer", "minimum": 0}, "allow_cross_host_redirects": {"type": "boolean"}, "credential_injection": {"description": "Where the runtime places the resolved credential on the outbound request: a header name and optional scheme. The value is resolved in the daemon and never appears here.", "type": "object", "additionalProperties": false, "required": ["location", "name"], "properties": {"location": {"const": "header"}, "name": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"}, "scheme": {"type": "string", "pattern": "^[A-Za-z]+$"}}}, "redaction": {"type": "object", "additionalProperties": false, "required": ["headers", "query_parameters", "response_fields"], "properties": {"headers": {"type": "array", "items": {"type": "string"}}, "query_parameters": {"type": "array", "items": {"type": "string"}}, "response_fields": {"type": "array", "items": {"type": "string"}}}}}}
  }
}
