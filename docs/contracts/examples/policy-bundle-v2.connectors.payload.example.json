          "request_max_bytes": 65536,
          "response_max_bytes": 1048576,
          "timeout_ms": 10000,
          "allow_redirects": false,
          "max_redirects": 0,
          "allow_cross_host_redirects": false,
          "credential_injection": {
            "location": "header",
            "name": "Authorization",
            "scheme": "Bearer"
          },
          "redaction": {
            "headers": [
              "Authorization"
            ],
            "query_parameters": [],
            "response_fields": [
              "email",
              "phone"
            ]
          }
        }
      },
      {
        "id": "conn-github",
        "name": "github",
        "provider": "github",
