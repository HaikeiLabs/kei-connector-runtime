{
"credential_fields": {
  "type": "array",
  "minItems": 1,
  "maxItems": 8,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["field", "header"],
    "properties": {
      "field":  { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
      "header": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,63}$" },
      "prefix": { "type": "string", "maxLength": 32, "pattern": "^[ -~]*$" }
    }
  }
}}
