{
  "schema": "kei.authorize-cases/v1",
  "cases_version": 2,
  "note": "Expected kei-policy-catalog decisions for calls against fixtures/kei/policy.v1.json. Any evaluator of that policy set (the catalog, a policy-bundle PEP in kei-connector-runtime, an agentware parity test) must reach the same outcome and the same deciding policy. Changing either file is a contract change: see fixtures/kei/README.md.",
  "policy_fixture": "policy.v1.json",
  "outcomes": {
    "allow": "The call may proceed. Wire decision: allow.",
    "deny": "Refused by a matching deny policy, or no policy matched. Wire decision: deny.",
    "approval_required": "A matching permit requires an approval that was not presented or is not valid. Wire decision: deny, reason \"approval required\".",
    "enrollment_required": "The provider identity is not linked to a Kei user; no policy is evaluated. Wire decision: enrollment_required."
  },
  "call_defaults": {
    "note": "Every call is made by installation inst-fixture-0001 (platform discord, workspace ws-fixture-0001) with its default agent. The subject is subjects.users[input.user]: authorize calls carry its provider_user_id; connector_invoke calls carry its id as the subject.",
    "installation_id": "inst-fixture-0001",
    "agent_id": "agent-fixture-0001",
    "resource": "github:repo:acme/sales-pipeline",
    "connector_resource": "repo:acme/sales-pipeline"
  },
  "cases": [
    {
      "id": "member_read_allow",
      "path": "authorize",
      "input": { "user": "member", "tool": "github.get_issue", "action": "github:read" },
      "expected": { "outcome": "allow", "policy_id": "pol-read-all" }
    },
    {
      "id": "admin_read_allow_via_nesting",
      "description": "admins contains members, so the admin matches the members read permit.",
      "path": "authorize",
      "input": { "user": "admin", "tool": "github.get_issue", "action": "github:read" },
      "expected": { "outcome": "allow", "policy_id": "pol-read-all" }
    },
    {
      "id": "admin_write_allow_by_priority",
      "description": "The admin matches both the admins permit (70) and the members deny (60); priority decides.",
      "path": "authorize",
      "input": { "user": "admin", "tool": "github.create_issue", "action": "github:write" },
      "expected": { "outcome": "allow", "policy_id": "pol-write-admin" }
    },
    {
      "id": "member_write_deny",
      "description": "Also the tenant-isolation check: the sibling workspace's permit (priority 90) must not decide.",
      "path": "authorize",
      "input": { "user": "member", "tool": "github.create_issue", "action": "github:write" },
      "expected": { "outcome": "deny", "policy_id": "pol-write-member-deny" }
    },
    {
      "id": "admin_destructive_deny",
      "path": "authorize",
      "input": { "user": "admin", "tool": "github.delete_repo", "action": "github:admin" },
      "expected": { "outcome": "deny", "policy_id": "pol-admin-destructive-deny" }
    },
    {
      "id": "member_destructive_deny",
      "path": "authorize",
      "input": { "user": "member", "tool": "github.delete_repo", "action": "github:admin" },
      "expected": { "outcome": "deny", "policy_id": "pol-admin-destructive-deny" }
    },
    {
      "id": "member_baseline_search_wiki_allow",
      "path": "authorize",
      "input": { "user": "member", "tool": "search_wiki", "action": "tool:search_wiki", "resource": "" },
      "expected": { "outcome": "allow", "policy_id": "pol-baseline-search-wiki" }
    },
    {
      "id": "member_baseline_search_web_allow",
      "path": "authorize",
      "input": { "user": "member", "tool": "search_web", "action": "tool:search_web", "resource": "" },
      "expected": { "outcome": "allow", "policy_id": "pol-baseline-search-web" }
    },
    {
      "id": "member_unregistered_tool_no_match_deny",
      "description": "A tool that is not in policy_set.tools and matches no policy falls through to the default deny.",
      "path": "authorize",
      "input": { "user": "member", "tool": "slack.post_message", "action": "slack:write", "resource": "slack:channel:general" },
      "expected": { "outcome": "deny", "policy_id": null }
    },
    {
      "id": "unlinked_enrollment_required",
      "description": "Replaces agentware's pol-unlinked-enroll rule: enrollment is identity state checked before any policy, not a policy row.",
      "path": "authorize",
      "input": { "user": "unlinked", "tool": "github.get_issue", "action": "github:read" },
      "expected": { "outcome": "enrollment_required", "policy_id": null }
    },
    {
      "id": "connector_get_allow",
      "path": "connector_invoke",
      "input": { "user": "member", "connector_id": "conn-github-0001", "capability": "issue.read", "action": "read" },
      "expected": { "outcome": "allow", "policy_id": "pol-connector-get" }
    },
    {
      "id": "connector_create_without_approval",
      "path": "connector_invoke",
      "input": { "user": "admin", "connector_id": "conn-github-0001", "capability": "issue.create", "action": "create" },
      "expected": { "outcome": "approval_required", "policy_id": "pol-connector-create-approval" }
    },
    {
      "id": "connector_create_with_approval_allow",
      "path": "connector_invoke",
      "input": { "user": "admin", "connector_id": "conn-github-0001", "capability": "issue.create", "action": "create", "approval_id": "appr-fixture-0001" },
      "expected": { "outcome": "allow", "policy_id": "pol-connector-create-approval" }
    },
    {
      "id": "connector_create_with_unknown_approval",
      "path": "connector_invoke",
      "input": { "user": "admin", "connector_id": "conn-github-0001", "capability": "issue.create", "action": "create", "approval_id": "appr-fixture-9999" },
      "expected": { "outcome": "approval_required", "policy_id": "pol-connector-create-approval" }
    },
    {
      "id": "connector_approval_other_resource",
      "description": "An approval is bound to its exact resource and cannot be used for another.",
      "path": "connector_invoke",
      "input": { "user": "admin", "connector_id": "conn-github-0001", "capability": "issue.create", "action": "create", "approval_id": "appr-fixture-0001", "resource": "repo:acme/other" },
      "expected": { "outcome": "approval_required", "policy_id": "pol-connector-create-approval" }
    }
  ]
}
